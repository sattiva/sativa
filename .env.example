# Serverless storage (Vercel KV / Upstash Redis). Without these the guestbook and the
# view counter fail closed; the vault player and arcade still work.
# Create a KV store in the Vercel dashboard, then copy the REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile. Leave both blank and the guestbook falls back to honeypot +
# dwell + origin pinning + rate limits. Set the secret and the widget arms itself --
# no rebuild needed, the client reads the public site key from GET /api/guestbook.
# Test keys that always pass verification:
#   site: 1x00000000000000000000AA   secret: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Last.fm. Register an API account at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional. The public Last.fm API exposes no distinct artist/track/album totals, so
# without this the UI shows a bounded lower bound (sweeps 400 rows per category) and
# flags it. Set the real numbers to display them exactly.
# LASTFM_COUNTS={"artists":1200,"tracks":3900,"albums":2600}