# Serverless storage (Vercel KV / Upstash Redis). Without these the guestbook returns
# 503 and listening stats are read-only (no counting). The vault player and arcade work.
#
# HOW TO GET THESE:
#   Option A (easiest) - Vercel dashboard:
#     Storage tab -> Create Database -> KV -> pick a region -> Create.
#     Open it -> Environment Variables tab -> click "Show" and copy
#     KV_REST_API_URL     -> UPSTASH_REDIS_REST_URL
#     KV_REST_API_TOKEN   -> UPSTASH_REDIS_REST_TOKEN
#     Paste both into Project Settings -> Environment Variables, all environments.
#
#   Option B - Upstash console:
#     console.upstash.com -> Create Database -> REST tab -> copy
#     UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
#
# The REST token is a bearer credential: it is sent to the Upstash REST endpoint on every
# request. Do not commit it, do not put it in client code. It is only ever read by api/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Baseline listening stats, seeded into Redis the first time the stats endpoint is hit.
# Everything after this point increments on top. Without it every number starts at zero.
# One env var, no seeding script, no admin endpoint. Wrap in single quotes so the shell and
# Vercel keep the $ and quotes intact.
# BASELINE_STATS={"scrobbles":45700,"artists":1200,"tracks":3900,"albums":2600,"days":658,"topArtist":"$uicideboy$","topArtistPlays":4100}
#
# To change the baseline later, delete the seed flag in Redis and set the new value:
#   DEL sx:seeded sx:total sx:top
# (the local incrementing counts sx:days / sx:artists / sx:tracks / sx:albums are additive
#  and are not reset, so artists/tracks/albums would double-count after a re-seed)

# Cloudflare Turnstile. Leave both blank and the guestbook falls back to honeypot +
# dwell + origin pinning + rate limits. Set the secret and the widget arms itself --
# no rebuild needed, the client reads the public site key from GET /api/guestbook.
# Cloudflare dashboard -> Turnstile -> Add widget -> hostname sativa.cfd.
# Test keys that always pass verification:
#   site: 1x00000000000000000000AA   secret: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=